<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
 "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
 "https://hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
 <session-factory>
   <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
   <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/instagram_db?createDatabaseIfNotExist=true&amp;serverTimezone=UTC</property>
   <property name="hibernate.connection.username">root</property>
   <property name="hibernate.connection.password">root</property>
   <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
   <property name="hibernate.hbm2ddl.auto">update</property>
   <property name="hibernate.show_sql">true</property>
   <property name="hibernate.format_sql">true</property>
   <mapping class="com.instagram.entity.User"/>
   <mapping class="com.instagram.entity.Post"/>
   <mapping class="com.instagram.entity.Comment"/>
   <mapping class="com.instagram.entity.PostLike"/>
   <mapping class="com.instagram.entity.Follower"/>
   <mapping class="com.instagram.entity.Story"/>
   <mapping class="com.instagram.entity.StoryView"/>
   <mapping class="com.instagram.entity.Hashtag"/>
   <mapping class="com.instagram.entity.PostHashtag"/>
   <mapping class="com.instagram.entity.SavedPost"/>
   <mapping class="com.instagram.entity.Conversation"/>
   <mapping class="com.instagram.entity.ConversationUser"/>
   <mapping class="com.instagram.entity.Message"/>
   <mapping class="com.instagram.entity.Notification"/>
 </session-factory>
</hibernate-configuration>
