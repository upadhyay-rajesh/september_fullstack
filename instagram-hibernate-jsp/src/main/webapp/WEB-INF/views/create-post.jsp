<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%-- Configures UTF-8 output. --%><!DOCTYPE html><%-- Declares HTML5. --%><html lang="en"><%-- Starts document. --%><head><meta charset="UTF-8"><%-- Sets encoding. --%><meta name="viewport" content="width=device-width, initial-scale=1"><%-- Enables responsive layout. --%><title>Create Post</title><%-- Sets title. --%><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"><%-- Loads CSS. --%></head>
<body><%-- Starts body. --%><main class="card"><%-- Centers the form. --%><h1>Create a Post</h1><%-- Displays heading. --%><% if (request.getAttribute("error") != null) { %><p class="error"><%= request.getAttribute("error") %></p><% } %><%-- Displays server-side errors. --%><form method="post" action="${pageContext.request.contextPath}/posts/create"><%-- Submits normal POST. --%><label>Caption</label><%-- Labels caption. --%><textarea name="caption" rows="4" required></textarea><%-- Collects caption. --%><label>Image URL (optional)</label><%-- Labels image URL. --%><input name="imageUrl"><%-- Collects image URL. --%><button type="submit">Publish</button><%-- Submits to PostServlet. --%></form><%-- Ends form. --%><p><a href="${pageContext.request.contextPath}/home">Back to feed</a></p><%-- Links to feed. --%></main><%-- Ends card. --%></body><%-- Ends body. --%></html><%-- Ends HTML. --%>
