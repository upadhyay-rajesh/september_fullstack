<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%-- Sets output encoding. --%><%@ page import="java.util.List,com.instagramhibernate.entity.User,com.instagramhibernate.entity.Post" %><%-- Imports result entity classes. --%><!DOCTYPE html><%-- Declares HTML5. --%><html lang="en"><%-- Starts document. --%><head><meta charset="UTF-8"><%-- Sets encoding. --%><title>Search</title><%-- Sets title. --%><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"><%-- Loads stylesheet. --%></head><body><%-- Starts body. --%><main class="content"><%-- Starts content. --%><h1>Search users and posts</h1><%-- Displays heading. --%><form method="get" action="${pageContext.request.contextPath}/search"><%-- Submits search through standard GET. --%><input name="q" value="<%= request.getAttribute("keyword") %>" placeholder="Search keyword"><%-- Collects keyword. --%><button type="submit">Search</button><%-- Submits form. --%></form><%-- Ends form. --%><h2>Users</h2><%-- Users heading. --%><% List<User> users = (List<User>) request.getAttribute("users"); if (users != null) { for (User user : users) { %><p><%= user.getUsername() %> — <%= user.getFullName() == null ? "" : user.getFullName() %></p><% } } %><%-- Renders user results. --%><h2>Posts</h2><%-- Posts heading. --%><% List<Post> posts = (List<Post>) request.getAttribute("posts"); if (posts != null) { for (Post post : posts) { %><article class="post"><strong><%= post.getUser().getUsername() %></strong><p><%= post.getCaption() == null ? "" : post.getCaption() %></p></article><% } } %><%-- Renders post results. --%><p><a href="${pageContext.request.contextPath}/home">Back to feed</a></p><%-- Provides return link. --%></main><%-- Ends content. --%></body><%-- Ends body. --%></html><%-- Ends document. --%>
