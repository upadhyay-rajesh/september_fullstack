<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%-- Configures UTF-8 output. --%>
<!DOCTYPE html><%-- Declares HTML5. --%><html lang="en"><%-- Starts document. --%><head><meta charset="UTF-8"><%-- Defines encoding. --%><meta name="viewport" content="width=device-width, initial-scale=1"><%-- Responsive viewport. --%><title>Register</title><%-- Browser title. --%><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"><%-- Loads CSS. --%></head>
<body><%-- Starts body. --%><main class="card"><%-- Centers registration form. --%><h1>Create Account</h1><%-- Page heading. --%><% if (request.getAttribute("error") != null) { %><p class="error"><%= request.getAttribute("error") %></p><% } %><%-- Shows registration errors. --%>
<form method="post" action="${pageContext.request.contextPath}/register"><%-- Uses normal form POST. --%><label>Full name</label><%-- Labels full name. --%><input name="fullName" required><%-- Collects full name. --%><label>Username</label><%-- Labels username. --%><input name="username" required><%-- Collects username. --%><label>Email</label><%-- Labels email. --%><input type="email" name="email" required><%-- Collects email. --%><label>Password</label><%-- Labels password. --%><input type="password" name="password" required><%-- Collects password. --%><button type="submit">Register</button><%-- Submits to RegisterServlet. --%></form><%-- Ends form. --%><p>Already registered? <a href="${pageContext.request.contextPath}/login">Login</a></p><%-- Links to login. --%></main><%-- Ends card. --%></body><%-- Ends body. --%></html><%-- Ends HTML. --%>
