<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%-- Configures response encoding. --%><%@ page import="java.util.List,com.instagramhibernate.entity.Post" %><%-- Imports Post and List for rendering request attributes. --%>
<!DOCTYPE html><%-- Declares HTML5. --%><html lang="en"><%-- Starts page. --%><head><meta charset="UTF-8"><%-- Sets character encoding. --%><meta name="viewport" content="width=device-width, initial-scale=1"><%-- Enables responsive page. --%><title>Home Feed</title><%-- Sets title. --%><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"><%-- Loads CSS. --%></head>
<body><%-- Starts body. --%><header><a href="${pageContext.request.contextPath}/home">Home</a> | <a href="${pageContext.request.contextPath}/posts/create">Create post</a> | <a href="${pageContext.request.contextPath}/search">Search</a> | <a href="${pageContext.request.contextPath}/logout">Logout</a></header><%-- Provides navigation links. --%><main class="content"><%-- Starts feed content. --%><h1>Your Feed</h1><%-- Displays heading. --%>
<% List<Post> posts = (List<Post>) request.getAttribute("posts"); %><%-- Reads post list placed by HomeServlet. --%><% if (posts == null || posts.isEmpty()) { %><p>No posts yet. Create a post or follow someone.</p><% } else { for (Post post : posts) { %><article class="post"><%-- Starts a post card. --%><h3><%= post.getUser().getUsername() %></h3><%-- Shows post author. --%><p><%= post.getCaption() == null ? "" : post.getCaption() %></p><%-- Shows caption. --%><% if (post.getImageUrl() != null && post.getImageUrl().trim().length() > 0) { %><p><a href="<%= post.getImageUrl() %>">Open image</a></p><% } %><%-- Shows an image URL as a link without JavaScript. --%><small>Post ID: <%= post.getId() %></small><%-- Shows ID for training/testing actions. --%></article><% } } %><%-- Ends feed loop. --%></main><%-- Ends main content. --%></body><%-- Ends body. --%></html><%-- Ends HTML. --%>
